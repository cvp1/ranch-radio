From cc5d3eaa2cff42c3f128f639d4570ca347eade05 Mon Sep 17 00:00:00 2001
From: cvp1 <54213066+cvp1@users.noreply.github.com>
Date: Sat, 21 Nov 2026 08:52:40 -0700
Subject: [PATCH 1/3] Ranch Radio hardening: TX off by default, auto-TX gated
 on autoReply, honest tx.send, Homebrew link fix

- txEnabled defaults false (config.h, config.cpp)
- MSG auto-ACK and YES MSG ID relay notice now require autoReply
- tx.send returns ok:false when TX is disarmed or no callsign
- link PortAudio/Hamlib via *_LINK_LIBRARIES (bare -l names fail under Homebrew)
- --web-host help text matches the 127.0.0.1 code default

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt     | 8 ++++----
 src/config.cpp     | 2 +-
 src/config.h       | 2 +-
 src/main.cpp       | 2 +-
 src/mainwindow.cpp | 4 ++--
 src/wsserver.cpp   | 6 ++++++
 6 files changed, 15 insertions(+), 9 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4ea5391..e254736 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -112,7 +112,7 @@ if(NOT PORTAUDIO_FOUND)
     find_path(PORTAUDIO_INCLUDE_DIR NAMES portaudio.h)
     if(PORTAUDIO_LIB)
         set(PORTAUDIO_FOUND TRUE)
-        set(PORTAUDIO_LIBRARIES "${PORTAUDIO_LIB}")
+        set(PORTAUDIO_LINK_LIBRARIES "${PORTAUDIO_LIB}")
         if(PORTAUDIO_INCLUDE_DIR)
             set(PORTAUDIO_INCLUDE_DIRS "${PORTAUDIO_INCLUDE_DIR}")
         endif()
@@ -320,7 +320,7 @@ target_link_libraries(jf8call PRIVATE
     Qt6::Sql
     gfsk8modem
     ${KISSFFT_LIBRARIES}
-    ${PORTAUDIO_LIBRARIES}
+    ${PORTAUDIO_LINK_LIBRARIES}
 )
 
 if(PULSE_FOUND)
@@ -337,7 +337,7 @@ if(HAMLIB_FOUND)
     message(STATUS "Hamlib found — radio control enabled")
     target_compile_definitions(jf8call PRIVATE HAVE_HAMLIB)
     target_include_directories(jf8call PRIVATE ${HAMLIB_INCLUDE_DIRS})
-    target_link_libraries(jf8call PRIVATE ${HAMLIB_LIBRARIES})
+    target_link_libraries(jf8call PRIVATE ${HAMLIB_LINK_LIBRARIES})
     if(HAMLIB_LDFLAGS_OTHER)
         target_link_options(jf8call PRIVATE ${HAMLIB_LDFLAGS_OTHER})
     endif()
@@ -445,7 +445,7 @@ if(EXISTS "${CMAKE_SOURCE_DIR}/cpp_tests/test_headless_core.cpp")
         Qt6::Sql
         gfsk8modem
         ${KISSFFT_LIBRARIES}
-        ${PORTAUDIO_LIBRARIES}
+        ${PORTAUDIO_LINK_LIBRARIES}
     )
     if(PULSE_FOUND)
         target_compile_definitions(test_headless_core PRIVATE HAVE_PULSE)
diff --git a/src/config.cpp b/src/config.cpp
index ea85aef..e973116 100644
--- a/src/config.cpp
+++ b/src/config.cpp
@@ -129,7 +129,7 @@ Config Config::load(const QString &overrideDir)
     c.heartbeatSubChannel       = o.value(u"heartbeatSubChannel").toBool(true);
     c.heartbeatAckEnabled       = o.value(u"heartbeatAckEnabled").toBool(false);
     c.clearBinWindowSecs        = std::clamp(o.value(u"clearBinWindowSecs").toInt(120), 15, 600);
-    c.txEnabled                 = o.value(u"txEnabled").toBool(true);
+    c.txEnabled                 = o.value(u"txEnabled").toBool(false);
     c.autoReply                 = o.value(u"autoReply").toBool(false);
     c.distMiles                 = o.value(u"distMiles").toBool(true);
     c.autoAtu                   = o.value(u"autoAtu").toBool(false);
diff --git a/src/config.h b/src/config.h
