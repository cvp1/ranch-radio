+
+void MainWindow::publishIncomplete(const FrameAssembler::Buffer &buf)
+{
+    if (buf.text.isEmpty())
+        return;
+    ModemDecoded d;
+    d.modemType   = 0;
+    d.isRawText   = false;
+    d.frequencyHz = buf.firstHz;
+    d.snrDb       = buf.snrDb;
+    d.submode     = buf.submode;
+    d.frameType   = Varicode::JS8CallLast; // force-complete
+    JF8Message msg = parseDecoded(d, buf.text, m_config.callsign);
+    m_decodedHistory.prepend(msg);
+    if (m_decodedHistory.size() > 500)
+        m_decodedHistory.resize(500);
+    if (!msg.from.isEmpty()) m_model->addMessage(msg);
+    if (m_wsServer) m_wsServer->pushMessageDecoded(msg);
+    emit messageDecoded(msg);
+    // Append timeout marker to heard pane
+    const int fKey = qRound(buf.firstHz / 10.0f);
+    auto hIt = m_heardFreqBlock.find(fKey);
+    if (hIt != m_heardFreqBlock.end()) {
+        hIt->text += QStringLiteral(" \u2666?");
+        rebuildHeardPane();
     }
