+#pragma once
+// GFSK8 multi-frame assembly: First, Middle..., Last frames of one message,
+// joined by the sender's audio offset.
+//
+// Two rules the inline version in MainWindow got wrong (off air, 2026-11-25:
+// a 13-frame Normal message from a drifting TS-480 came out as its first two
+// frames, the rest as loose pieces):
+//
+//   * A buffer expires on SILENCE, not on age. The old code force-completed
+//     every buffer 60 s after its FIRST frame, so any Normal message longer
+//     than ~5 frames (15 s each) was cut while it was still being sent.
+//     Now: SILENCE_FRAMES frame periods with nothing heard, or MAX_AGE_S in all.
+//   * A frame joins the NEAREST open buffer within NEAR_HZ of the offset that
+//     buffer last heard, and the buffer follows the drift. The old code keyed
+//     buffers by qRound(freq / 10), a fixed 10 Hz bucket: a rig drifting across
+//     a bucket edge (2096.9 -> 2092.3 Hz) lost every frame on the far side.
+
+#include <QList>
+#include <QString>
+#include <QtGlobal>
+#include <cmath>
+#include <optional>
+
+class FrameAssembler {
+public:
+    static constexpr float  NEAR_HZ        = 10.0f;  // as JS8Call's receive threshold
+    static constexpr int    SILENCE_FRAMES = 8;      // frames lost to QSB (90 s seen off air) don't end a message
+    static constexpr qint64 MAX_AGE_S      = 600;    // nothing assembles forever
+
+    struct Buffer {
+        QString text;          // rawText of the frames so far
+        qint64  firstSec = 0;
+        qint64  lastSec  = 0;
+        float   freqHz   = 0;  // the offset last heard (follows drift)
+        float   firstHz  = 0;
+        int     snrDb    = 0;  // first frame's
+        int     submode  = 0;
+    };
+
+    // Seconds one frame takes in a submode (0 Normal, 1 Fast, 2 Turbo, 4 Slow, 8 Ultra).
+    static int periodSec(int submode)
+    {
+        switch (submode) {
+            case 1: return 10;
+            case 2: return 6;
+            case 4: return 30;
+            case 8: return 4;
+            default: return 15;
+        }
+    }
+
+    // A First frame. A buffer already open near this offset is a message whose
+    // Last frame was never heard: it is returned, to be published as incomplete.
+    std::optional<Buffer> first(float freqHz, const QString &text, int snrDb, int submode, qint64 now)
+    {
+        std::optional<Buffer> flushed;
+        const int i = nearest(freqHz);
+        if (i >= 0)
+            flushed = m_bufs.takeAt(i);
+        Buffer b;
+        b.text = text;
+        b.firstSec = b.lastSec = now;
+        b.freqHz = b.firstHz = freqHz;
+        b.snrDb = snrDb;
+        b.submode = submode;
+        m_bufs.append(b);
+        return flushed;
+    }
+
+    // A Middle frame: appended to the nearest buffer. The assembled text so
+    // far, or nullopt if no buffer is open near this offset.
+    std::optional<QString> middle(float freqHz, const QString &text, qint64 now)
+    {
+        const int i = nearest(freqHz);
+        if (i < 0)
+            return std::nullopt;
+        Buffer &b = m_bufs[i];
+        b.text += text;
+        b.lastSec = now;
+        b.freqHz = freqHz;
+        return b.text;
+    }
+
+    // A Last frame: the whole message, its buffer closed; nullopt if none was open.
+    std::optional<Buffer> last(float freqHz, const QString &text, qint64 now)
+    {
+        const int i = nearest(freqHz);
+        if (i < 0)
+            return std::nullopt;
+        Buffer b = m_bufs.takeAt(i);
+        b.text += text;
+        b.lastSec = now;
+        b.freqHz = freqHz;
+        return b;
+    }
+
+    // Buffers gone silent (or too old), closed and returned to be published as incomplete.
+    QList<Buffer> expire(qint64 now)
+    {
+        QList<Buffer> out;
+        for (int i = m_bufs.size() - 1; i >= 0; --i) {
+            const Buffer &b = m_bufs[i];
+            if (now - b.lastSec > qint64(SILENCE_FRAMES) * periodSec(b.submode)
+                    || now - b.firstSec > MAX_AGE_S)
+                out.prepend(m_bufs.takeAt(i));
+        }
+        return out;
+    }
+
+    int size() const { return int(m_bufs.size()); }
+
+private:
+    int nearest(float freqHz) const
+    {
+        int best = -1;
+        float bestD = NEAR_HZ + 0.001f;
+        for (int i = 0; i < m_bufs.size(); ++i) {
+            const float d = std::fabs(m_bufs[i].freqHz - freqHz);
+            if (d < bestD) {
+                bestD = d;
+                best = i;
+            }
+        }
+        return best;
+    }
+
+    QList<Buffer> m_bufs;
+};
