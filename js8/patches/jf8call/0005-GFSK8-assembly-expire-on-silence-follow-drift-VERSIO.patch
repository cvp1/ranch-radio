+// SPDX-License-Identifier: GPL-3.0-or-later
+// FrameAssembler, replaying frames heard off air (2026-11-25, 20 m, Normal):
+// a TS-480 drifted 2096.9 -> 2092.3 Hz across a 13-frame-class message,
+// and its sender's sign-off lost five frames to QSB. The old assembler published the
+// first two frames of each. Checks run in Release too (no assert()).
+
+#include <cstdio>
+#include <cstdlib>
+#include "frameassembler.h"
+
+static int failures = 0;
+#define CHECK(c) do { if (!(c)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); ++failures; } } while (0)
+
+struct F { int t; float hz; char kind; const char *text; };   // kind: F(irst) M(iddle) L(ast)
+
+// Feed frames, running expire() every 5 s as the 5 s timer does. Returns the
+// messages published, completed or incomplete, in order.
+static QList<QString> replay(FrameAssembler &a, const QList<F> &frames, qint64 t0, int runFor)
+{
+    QList<QString> out;
+    int next = 0;
+    for (int t = 0; t <= runFor; ++t) {
+        if (t % 5 == 0)
+            for (const auto &b : a.expire(t0 + t))
+                out.append(QStringLiteral("~") + b.text);   // ~ marks incomplete
+        while (next < frames.size() && frames[next].t == t) {
+            const F &f = frames[next++];
+            const QString s = QString::fromLatin1(f.text);
+            if (f.kind == 'F') {
+                if (auto st = a.first(f.hz, s, -10, 0, t0 + t)) out.append(QStringLiteral("~") + st->text);
+            } else if (f.kind == 'M') {
+                a.middle(f.hz, s, t0 + t);
+            } else if (auto w = a.last(f.hz, s, t0 + t)) {
+                out.append(w->text);
+            }
+        }
+    }
+    return out;
+}
+
+int main()
+{
+    const qint64 t0 = 1764114975;   // 2026-11-25T23:56:15Z
+
+    {   // 1. Drift across the old 10 Hz bucket edge (2095 Hz), 105 s long.
+        FrameAssembler a;
+        const QList<F> fr = {
+            {0, 2096.875f, 'F', "K0ABC: KE2XYZ  "},
+            {15, 2095.875f, 'M', "GOOD DEAL. YOU'RE "},
+            {30, 2093.25f, 'M', "DOING PRETTY WELL INTO "},
+            {45, 2092.25f, 'M', "THE MIDWEST. BAND CDX "},
+            {60, 2094.75f, 'M', "AREN'T GREAT TONIGHT--"},
+            {75, 2095.25f, 'M', "I COULDN'T GET A WINL"},
+            {90, 2095.25f, 'M', "INK CONNECTION FOR THE "},
+            {105, 2094.75f, 'L', "LIFE OF ME."},
+        };
+        const auto out = replay(a, fr, t0, 400);
+        CHECK(out.size() == 1);
+        CHECK(!out.isEmpty() && out[0] == QStringLiteral(
+            "K0ABC: KE2XYZ  GOOD DEAL. YOU'RE DOING PRETTY WELL INTO THE MIDWEST. BAND CDX "
+            "AREN'T GREAT TONIGHT--I COULDN'T GET A WINLINK CONNECTION FOR THE LIFE OF ME."));
+        CHECK(a.size() == 0);
+    }
+
+    {   // 2. The sign-off: five frames lost (a 90 s gap), then the rest and its Last.
+        FrameAssembler a;
+        const QList<F> fr = {
+            {0, 2099.5f, 'F', "K0ABC: KE2XYZ  "},
+            {15, 2099.0f, 'M', "THX FOR THE QSO, "},
+            {105, 2100.5f, 'M', "RADIO KENWOOD TS-480"},
+            {120, 2100.0f, 'M', "HX ANTENNA EFHW POWER "},
+            {150, 2099.5f, 'M', "QTH NOWHERE, GRID "},
+            {165, 2099.0f, 'L', "FN31 73!"},
+        };
+        const auto out = replay(a, fr, t0, 400);
+        CHECK(out.size() == 1);
+        CHECK(!out.isEmpty() && out[0].startsWith(QStringLiteral("K0ABC: KE2XYZ  THX FOR THE QSO, RADIO")));
+        CHECK(!out.isEmpty() && out[0].endsWith(QStringLiteral("FN31 73!")));
+    }
+
+    {   // 3. Silence ends a message: published incomplete, but not before 8 frame periods.
+        FrameAssembler a;
+        a.first(1500.0f, QStringLiteral("W1AW: N0CALL  "), -5, 0, t0);
+        a.middle(1500.0f, QStringLiteral("HELLO "), t0 + 15);
+        CHECK(a.expire(t0 + 15 + 120).isEmpty());          // exactly 8 x 15 s: still open
+        const auto gone = a.expire(t0 + 15 + 121);
+        CHECK(gone.size() == 1 && gone[0].text == QStringLiteral("W1AW: N0CALL  HELLO "));
+        CHECK(a.size() == 0);
+    }
+
+    {   // 4. Two stations 40 Hz apart stay apart.
+        FrameAssembler a;
+        a.first(1000.0f, QStringLiteral("AA1AA: "), 0, 0, t0);
+        a.first(1040.0f, QStringLiteral("BB2BB: "), 0, 0, t0);
+        a.middle(1003.0f, QStringLiteral("ONE "), t0 + 15);
+        a.middle(1038.0f, QStringLiteral("TWO "), t0 + 15);
+        auto x = a.last(1001.0f, QStringLiteral("END"), t0 + 30);
+        auto y = a.last(1041.0f, QStringLiteral("END"), t0 + 30);
+        CHECK(x && x->text == QStringLiteral("AA1AA: ONE END"));
+        CHECK(y && y->text == QStringLiteral("BB2BB: TWO END"));
+    }
+
+    {   // 5. A new First where a message never got its Last flushes the old one.
+        FrameAssembler a;
+        a.first(1200.0f, QStringLiteral("CC3CC: "), 0, 0, t0);
+        a.middle(1200.0f, QStringLiteral("CUT "), t0 + 15);
+        auto st = a.first(1202.0f, QStringLiteral("CC3CC: "), 0, 0, t0 + 60);
+        CHECK(st && st->text == QStringLiteral("CC3CC: CUT "));
+        CHECK(a.size() == 1);
+        CHECK(!a.middle(1300.0f, QStringLiteral("X"), t0 + 75));   // nothing open near 1300
+    }
+
+    {   // 6. Nothing assembles forever.
+        FrameAssembler a;
+        a.first(900.0f, QStringLiteral("DD4DD: "), 0, 4, t0);      // Slow: 30 s frames
+        for (int t = 30; t <= 600; t += 30) a.middle(900.0f, QStringLiteral("."), t0 + t);
+        CHECK(a.expire(t0 + 600).isEmpty());
+        CHECK(a.expire(t0 + 601).size() == 1);
+    }
+
+    if (failures) {
+        std::fprintf(stderr, "%d frameassembler check(s) FAILED\n", failures);
+        return 1;
+    }
+    std::puts("All frameassembler tests PASSED.");
+    return 0;
+}
