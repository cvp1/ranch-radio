+		return 0;
+
+	strcpy(dest, WriteDevices[n]);
+	return strlen(dest);
+}
+
+
+int GetInputDeviceCollection()
+{
+	ZF_LOGI("Capture Devices\n");
+	return GetDeviceCollection(TRUE, &ReadDevices, &ReadDeviceCount);
+}
+
+int GetNextInputDevice(char * dest, int max, int n)
+{
+	if (n >= ReadDeviceCount)
+		return 0;
+
+	strcpy(dest, ReadDevices[n]);
+	return strlen(dest);
+}
+
+static void ClosePlayback()
+{
+	if (playhandle)
+	{
+		// Pa_StopStream lets queued samples finish playing; Pa_CloseStream
+		// alone would discard them and clip the end of the frame.
+		Pa_StopStream(playhandle);
+		Pa_CloseStream(playhandle);
+		playhandle = NULL;
+	}
+}
+
+static void CloseCapture()
+{
+	if (rechandle)
+	{
+		Pa_AbortStream(rechandle);
+		Pa_CloseStream(rechandle);
+		rechandle = NULL;
+	}
+}
+
+static int OpenStream(PaStream ** stream, PaDeviceIndex dev, BOOL input, int channels, int rate, PaError * perr)
+{
+	PaStreamParameters p;
+	const PaDeviceInfo * info = Pa_GetDeviceInfo(dev);
+
+	memset(&p, 0, sizeof(p));
+	p.device = dev;
+	p.channelCount = channels;
+	p.sampleFormat = paInt16;
+	p.suggestedLatency = input ? info->defaultLowInputLatency : info->defaultLowOutputLatency;
+	p.hostApiSpecificStreamInfo = NULL;
+
+	*perr = Pa_OpenStream(stream, input ? &p : NULL, input ? NULL : &p, rate,
+		rate / 100, paClipOff, NULL, NULL);
+	return *perr == paNoError;
+}
+
+int OpenSoundPlayback(char * PlaybackDevice, int m_sampleRate, int channels, char * ErrorMsg)
+{
+	PaDeviceIndex dev;
+	PaError err;
+
+	ClosePlayback();
+
+	dev = FindDevice(PlaybackDevice, FALSE);
+	if (dev == paNoDevice)
+	{
+		if (ErrorMsg)
+			sprintf (ErrorMsg, "cannot find playback audio device %s", PlaybackDevice);
+		else
+			ZF_LOGE("cannot find playback audio device %s", PlaybackDevice);
+		return false;
+	}
+
+	// Initial call has channels set to 1. Subequent ones set to what worked last time
+
+	if (!OpenStream(&playhandle, dev, FALSE, channels, m_sampleRate, &err))
+	{
+		ZF_LOGE("cannot open playback device %s with %d channels at %d Hz (%s)",
+			Pa_GetDeviceInfo(dev)->name, channels, m_sampleRate, Pa_GetErrorText(err));
+
+		if (channels == 2)
+			return false;  // Shouldn't happen as should have worked before
+
+		channels = 2;
+
+		if (!OpenStream(&playhandle, dev, FALSE, 2, m_sampleRate, &err))
+		{
+			if (ErrorMsg)
+				sprintf (ErrorMsg, "cannot open playback device with 2 channels (%s)", Pa_GetErrorText(err));
+			else
+				ZF_LOGE("cannot open playback device with 2 channels (%s)", Pa_GetErrorText(err));
+			playhandle = NULL;
+			return false;
+		}
+	}
+
+	if ((err = Pa_StartStream(playhandle)) != paNoError)
+	{
+		ZF_LOGE("cannot start playback stream (%s)", Pa_GetErrorText(err));
+		Pa_CloseStream(playhandle);
+		playhandle = NULL;
+		return false;
+	}
+
+	Savedplaychannels = m_playchannels = channels;
+	return true;
+}
+
+int OpenSoundCapture(char * CaptureDevice, int m_sampleRate, char * ErrorMsg)
+{
+	PaDeviceIndex dev;
+	PaError err;
+
+	CloseCapture();
+
+	dev = FindDevice(CaptureDevice, TRUE);
+	if (dev == paNoDevice)
+	{
+		if (ErrorMsg)
+			sprintf (ErrorMsg, "cannot find capture audio device %s", CaptureDevice);
+		else
+			ZF_LOGE("cannot find capture audio device %s", CaptureDevice);
+		return false;
+	}
+
+	m_recchannels = 1;
+
+	if (UseLeftRX == 0 || UseRightRX == 0)
+		m_recchannels = 2;  // L/R implies stereo
+
+	if (!OpenStream(&rechandle, dev, TRUE, m_recchannels, m_sampleRate, &err))
+	{
+		ZF_LOGE("cannot open capture device %s with %d channels at %d Hz (%s)",
+			Pa_GetDeviceInfo(dev)->name, m_recchannels, m_sampleRate, Pa_GetErrorText(err));
+
+		if (m_recchannels == 2)
+		{
+			if (ErrorMsg)
+				sprintf (ErrorMsg, "cannot open capture device (%s)", Pa_GetErrorText(err));
+			rechandle = NULL;
+			return false;
+		}
+
+		m_recchannels = 2;
+
+		if (!OpenStream(&rechandle, dev, TRUE, 2, m_sampleRate, &err))
+		{
+			if (ErrorMsg)
+				sprintf (ErrorMsg, "cannot open capture device with 2 channels (%s)", Pa_GetErrorText(err));
+			else
+				ZF_LOGE("cannot open capture device with 2 channels (%s)", Pa_GetErrorText(err));
+			rechandle = NULL;
+			return false;
+		}
+		ZF_LOGI("Record channel count set to 2");
+	}
+
+	if ((err = Pa_StartStream(rechandle)) != paNoError)
+	{
+		ZF_LOGE("cannot start capture stream (%s)", Pa_GetErrorText(err));
+		Pa_CloseStream(rechandle);
+		rechandle = NULL;
+		return false;
+	}
+
+	ZF_LOGD("Capture device %s open", Pa_GetDeviceInfo(dev)->name);
+	return TRUE;
+}
+
+int OpenSoundCard(char * CaptureDevice, char * PlaybackDevice, int c_sampleRate, int p_sampleRate, char * ErrorMsg)
+{
+	int Channels = 1;
+
+	if (UseLeftRX == 1 && UseRightRX == 1)
+	{
+		ZF_LOGI("Using Both Channels of soundcard for RX");
+	}
+	else
+	{
+		if (UseLeftRX == 0)
+			ZF_LOGI("Using Right Channel of soundcard for RX");
+		if (UseRightRX == 0)
+			ZF_LOGI("Using Left Channel of soundcard for RX");
+	}
+
+	if (UseLeftTX == 1 && UseRightTX == 1)
+	{
+		ZF_LOGI("Using Both Channels of soundcard for TX");
+	}
+	else
+	{
+		if (UseLeftTX == 0)
+			ZF_LOGI("Using Right Channel of soundcard for TX");
+		if (UseRightTX == 0)
+			ZF_LOGI("Using Left Channel of soundcard for TX");
+	}
+
+	ZF_LOGI("Opening Playback Device %s Rate %d", PlaybackDevice, p_sampleRate);
+
+	if (UseLeftTX == 0 || UseRightTX == 0)
+		Channels = 2;  // L or R implies stereo
+
+	strcpy(SavedPlaybackDevice, PlaybackDevice);  // Saved so we can reopen in error recovery
+	SavedPlaybackRate = p_sampleRate;
+	if (OpenSoundPlayback(PlaybackDevice, p_sampleRate, Channels, ErrorMsg))
+	{
+#ifdef SHARECAPTURE
+
+		// Close playback device so it can be shared
+
+		ClosePlayback();
+#endif
+		ZF_LOGI("Opening Capture Device %s Rate %d", CaptureDevice, c_sampleRate);
+
+		strcpy(SavedCaptureDevice, CaptureDevice);  // Saved so we can reopen in error recovery
+		SavedCaptureRate = c_sampleRate;
+		return OpenSoundCapture(CaptureDevice, c_sampleRate, ErrorMsg);
+	}
+	else
+		return false;
+}
+
+
+
+int CloseSoundCard()
+{
+	CloseCapture();
+	ClosePlayback();
+	return 0;
+}
+
+
+int SoundCardWrite(short * input, unsigned int nSamples)
+{
+	long avail;
+
+	if (playhandle == NULL)
+		return 0;
+
+	// Stop Capture
+
+	CloseCapture();
+
+	return PackSamplesAndSend(input, nSamples);
+}
+
+int PackSamplesAndSend(short * input, int nSamples)
+{
+	static short samples[256000];
+	short * sampptr = samples;
+	unsigned int n;
+	PaError err;
+
+	if (m_playchannels == 1)
+	{
+		for (n = 0; n < nSamples; n++)
+		{
+			*(sampptr++) = input[0];
+			input ++;
+		}
+	}
+	else
+	{
+		for (n = 0; n < nSamples; n++)
+		{
+			if (UseLeftTX)
+				*(sampptr++) = input[0];
+			else
+				*(sampptr++) = 0;
+
+			if (UseRightTX)
+				*(sampptr++) = input[0];
+			else
+				*(sampptr++) = 0;
+
+			input ++;
+		}
+	}
+
+	// The PortAudio output buffer can be smaller than one block (1200 samples
+	// at 12 kHz with low latency), so write whatever fits and keep the host
+	// and webgui serviced while it drains.  Waiting for room for the whole
+	// block, as the ALSA version does, never ends.
+	{
+		int done = 0;
+
+		while (done < nSamples)
+		{
+			long avail = Pa_GetStreamWriteAvailable(playhandle);
+			long chunk = nSamples - done;
+
+			if (avail == 0)
+			{
+				txSleep(2);
+				continue;
+			}
+			if (avail > 0 && avail < chunk)
+				chunk = avail;
+
+			err = Pa_WriteStream(playhandle, samples + done * m_playchannels, chunk);
+
+			if (err != paNoError && err != paOutputUnderflowed)
+			{
+				ZF_LOGD("Playback write error (%s)", Pa_GetErrorText(err));
+				return -1;
+			}
+			done += chunk;
+		}
+	}
+	return nSamples;
+}
+
+int SoundCardRead(short * input, unsigned int nSamples)
+{
+	static short samples[65536];
+	unsigned int n;
+	long avail;
+	PaError err;
+
+	if (rechandle == NULL)
+		return 0;
+
+	avail = Pa_GetStreamReadAvailable(rechandle);
+
+	if (avail < 0)
+	{
+		ZF_LOGD("avail Recovering from %s ..", Pa_GetErrorText(avail));
+		OpenSoundCapture(SavedCaptureDevice, SavedCaptureRate, NULL);
+		return 0;
+	}
+
+	if (avail < nSamples)
+		return 0;
+
+	err = Pa_ReadStream(rechandle, samples, nSamples);
+
+	if (err == paInputOverflowed)
+		ZF_LOGD("RX overflow; samples were lost");
+	else if (err != paNoError)
+	{
+		ZF_LOGE("RX Error %s", Pa_GetErrorText(err));
+		OpenSoundCapture(SavedCaptureDevice, SavedCaptureRate, NULL);
+		return 0;
+	}
+
+	if (m_recchannels == 1)
+		memcpy(input, samples, nSamples * sizeof(short));
+	else
+	{
+		int start = UseLeftRX ? 0 : 1;
+
+		for (n = 0; n < nSamples; n++)  // take one channel of each frame
+			input[n] = samples[2 * n + start];
+	}
+	return nSamples;
+}
