+	if (strcmp(PlaybackDevice, "NOSOUND") != 0)
+		OpenSoundCapture(SavedCaptureDevice, SavedCaptureRate, strFault);
+	StartCapture();
+
+	if (WriteRxWav)
+		// Start recording if not already recording, else to extend the recording time.
+		StartRxWav();
