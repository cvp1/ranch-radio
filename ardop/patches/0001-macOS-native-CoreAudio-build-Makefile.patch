diff --git a/Makefile b/Makefile
index d6d4eb1..a45d1b8 100644
--- a/Makefile
+++ b/Makefile
@@ -77,6 +77,11 @@ OBJS_LIN = \
 	src/linux/ALSASound.o \
 	src/linux/LinSerial.o \
 
+# macOS-only object files (PortAudio sound, POSIX serial shared with Linux)
+OBJS_MAC = \
+	src/mac/MacSound.o \
+	src/linux/LinSerial.o \
+
 # Windows-only object files
 OBJS_WIN = \
 	src/windows/Waveout.o \
@@ -126,6 +131,17 @@ WIN32 ?= $(filter $(OS),Windows_NT)
 ifneq ($(WIN32),)
 OBJS += $(OBJS_WIN)
 LDLIBS += -lwsock32 -lwinmm -lsetupapi -lws2_32
+else ifeq ($(shell uname -s),Darwin)
+# macOS: brew install portaudio
+BREW_PREFIX ?= $(shell brew --prefix 2>/dev/null || echo /opt/homebrew)
+OBJS += $(OBJS_MAC)
+CPPFLAGS += -I$(BREW_PREFIX)/include -DARDOP_HOST_LOOPBACK_ONLY
+CFLAGS += -Wno-int-conversion -Wno-incompatible-pointer-types
+LDLIBS += -L$(BREW_PREFIX)/lib -lportaudio -framework CoreAudio -framework CoreFoundation
+# Embedded Info.plist gives macOS a bundle id and microphone usage text, so
+# the microphone (capture) permission can be prompted for and remembered.
+LDFLAGS = -Xlinker -map -Xlinker output.map -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker src/mac/Info.plist
+CC = cc
 else
 OBJS += $(OBJS_LIN)
 LDLIBS += -lrt -lasound
@@ -135,6 +151,9 @@ all: ardopcf
 
 ardopcf: $(OBJS_EXE) $(OBJS)
 	$(CC) $(LDFLAGS) $^ -o $@ $(LOADLIBES) $(LDLIBS)
+ifeq ($(shell uname -s),Darwin)
+	codesign --force --sign - --identifier org.ranch-radio.ardopcf $@
+endif
 
 # if txt2c is not provided, build it
 ifeq ($(TXT2C),)
