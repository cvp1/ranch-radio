 lib/zf_log/zf_log/zf_log.c    |    4 +-
 src/common/TCPHostInterface.c |    8 +
 src/mac/Info.plist            |   12 +
 src/mac/MacSound.c            | 1859 +++++++++++++++++++++++++++++++++
