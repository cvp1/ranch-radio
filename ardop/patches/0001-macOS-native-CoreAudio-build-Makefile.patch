+// PTT via GPIO code
+
+#if defined(__ARM_ARCH) && defined(__linux__)
+
+#define PI_INPUT 0
+#define PI_OUTPUT 1
+#define PI_ALT0 4
+#define PI_ALT1 5
+#define PI_ALT2 6
+#define PI_ALT3 7
+#define PI_ALT4 3
+#define PI_ALT5 2
+
+// Set GPIO pin as output and set low
+
+extern int pttGPIOPin;
+extern BOOL pttGPIOInvert;
+
+
+
+void SetupGPIOPTT()
+{
+	if (pttGPIOPin == -1)
+	{
+		ZF_LOGI("GPIO PTT disabled");
+		RadioControl = FALSE;
+		useGPIO = FALSE;
+	}
+	else
+	{
+		if (pttGPIOPin < 0) {
+			pttGPIOInvert = TRUE;
+			pttGPIOPin = -pttGPIOPin;
+		}
+
+		gpioSetMode(pttGPIOPin, PI_OUTPUT);
+		gpioWrite(pttGPIOPin, pttGPIOInvert ? 1 : 0);
+		ZF_LOGI("Using GPIO pin %d for PTT", pttGPIOPin);
+		RadioControl = TRUE;
+		useGPIO = TRUE;
+	}
+}
+#endif
